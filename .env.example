# Speak2Fill Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection URI (Local or MongoDB Atlas)
# If local MongoDB is not running, the app automatically switches to an in-memory/file-backed persistent store
MONGODB_URI=mongodb://127.0.0.1:27017/speak2fill

# Google Gemini API Key for Form Field Detection (Vision)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Sarvam AI API Key for Indic Speech-to-Text (STT) and Text-to-Speech (TTS)
# Supported languages: Malayalam (ml-IN), Hindi (hi-IN), Tamil (ta-IN), Telugu (te-IN), English (en-IN)
# Get a key from: https://www.sarvam.ai/
SARVAM_API_KEY=

# Node Environment
NODE_ENV=development
